# Copy to .env and fill in what you need. Nothing here is required:
# DrugForge runs without any API key and reports the optional stages as
# unavailable. Never commit a filled-in .env.

# Enables the grounded plain-language explanation.
DEEPSEEK_API_KEY=

# Enables Boltz-2 AI binding confirmation. Cloud only, never run locally.
BOLTZ_API_KEY=

# Cores each docking run may use. Keep low on a shared or small host:
# Vina otherwise takes every available core.
DRUGFORGE_VINA_CPU=2

# Writable directories. Defaults sit next to the repository.
# DRUGFORGE_DATA_DIR=/var/lib/drugforge
# DRUGFORGE_DB_PATH=/var/lib/drugforge/results.db
# DRUGFORGE_STATIC_DIR=/srv/drugforge/static
